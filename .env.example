# Copiar a .env y completar con contraseñas propias:
#   cp .env.example .env
#
# MYSQL_PASSWORD y DB_PASSWORD deben coincidir cuando DB_USER = MYSQL_USER.
# No uses root en el backend: conecta con el usuario de aplicación (alumno).

MYSQL_ROOT_PASSWORD=REEMPLAZAR_PASSWORD_ROOT
MYSQL_DATABASE=tienda_perritos
MYSQL_USER=alumno
MYSQL_PASSWORD=REEMPLAZAR_PASSWORD_APP

DB_HOST=db
DB_USER=alumno
DB_PASSWORD=REEMPLAZAR_PASSWORD_APP
DB_NAME=tienda_perritos
DB_PORT=3306
